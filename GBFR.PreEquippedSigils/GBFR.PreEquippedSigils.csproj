<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>GBFR.PreEquippedSigils</AssemblyName>
    <RootNamespace>GBFR.PreEquippedSigils</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Reloaded.Mod.Interfaces" Version="2.5.0" ExcludeAssets="runtime" />
    <!-- 因子编辑那一半从游戏归档里取 skill_status.tbl：没有这个管理器就没有表可改。 -->
    <PackageReference Include="gbfrelink.utility.manager.Interfaces" Version="1.2.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ModConfig.json" CopyToOutputDirectory="Always" />
    <None Include="README.md" CopyToOutputDirectory="Always" />
    <!-- 因子表的源头在工具的 assets\ 里（工具也要读同一份），打包时按 gem.json 这个名字
         发到 mod 目录——native 与 C# 都是按这个名字找它的。 -->
    <None Include="..\Loadout\assets\gem.json"
          Link="gem.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="character-exclusives.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\GBFR.PreEquippedSigils.Native\bin\$(Configuration)\GBFR.PreEquippedSigils.Native.dll"
          Link="GBFR.PreEquippedSigils.Native.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
