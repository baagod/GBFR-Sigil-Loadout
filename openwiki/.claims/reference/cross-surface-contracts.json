  "claims": [
    {
      "id": "claim_14646b71fd4e4aeaaf3e31627062a5b5",
      "statement": "LoadoutConfig does one thing only: it maps the payload the visual tool wrote into an ABI structure, reads no data file and holds no table; the semantics of item to main skill and cap belong solely to the single writer, so whether the choice was correct or over the cap is not re-judged in this layer.",
      "evidence": [
        {
          "resource": "repo://GBFR.SigilLoadout/LoadoutConfig.cs#L6-L26",
          "version": "repo-lines-v1:sha256:4641c5864482b72739dbfa4c4838189334163975064f8a78273de87f66e1f97c:"
        }
      ]
    },
    {
      "id": "claim_818d12fdcbc74f54a981a266a5c7f71e",
      "statement": "LoadoutConfig performs shape validation only: malformed JSON, a missing skill hash, a bad level, or too many enabled slots.",
      "evidence": [
        {
          "resource": "repo://GBFR.SigilLoadout/LoadoutConfig.cs#L24-L26",
          "version": "repo-lines-v1:sha256:76c0d1a7324461433dd1036d0e19cc15a46fb40a183f381c38692d63bf3cdd3d:"
        }
      ]
    },
    {
